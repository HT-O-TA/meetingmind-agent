# ============================================
# MeetingMind Docker 基础设施环境变量配置
# 复制此文件为根目录 .env；默认 Compose 只启动 Redis/RabbitMQ。
# backend/.env 供本机 Conda 后端；前端使用 Conda 环境中的 Node/npm。
# ============================================

# ==================== 应用基础配置 ====================
APP_NAME=MeetingMind
APP_ENV=development
MEETINGMIND_DEBUG=false
# 仅开发默认值；production 必须换成至少 32 字符的随机值。
SECRET_KEY=meetingmind-dev-only-secret-change-before-production

# ==================== 数据库配置 ====================
# PostgreSQL 安装在宿主机。下面的地址只供可选 container-app Profile 使用；
# Conda 后端使用 backend/.env 中的 localhost 地址。
DATABASE_URL=postgresql+asyncpg://postgres:change-me@host.docker.internal:5432/meetingmind

# ==================== Redis配置 ====================
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
QUEUE_PREFETCH_COUNT=1
QUEUE_MAX_RETRIES=2
QUEUE_RETRY_DELAY_SECONDS=5

# ==================== 本地 ASR（可选）====================
ENABLE_ASR=false
ASR_DEVICE=auto
ASR_MODEL=paraformer-zh
ASR_VAD_MODEL=fsmn-vad
ASR_PUNC_MODEL=ct-punc
ASR_SPK_MODEL=cam++
# ASR/FunASR 不在默认 Web 镜像中，按阶段4文档使用独立 GPU 环境运行。

# ==================== CORS配置 ====================
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]

# ==================== LLM配置 ====================
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 冻结评测曾使用 qwen3.7-max-2026-06-08；其授权于 2026-09-08 到期。
# 项目持续运行默认切换到 qwen3.7-flash，所有 Agent 档位由 Compose 映射到此名称。
LLM_MODEL=qwen3.7-flash

# 轻量 Web/Worker 镜像不包含本地模型运行库，必须保持关闭。
ENABLE_RERANK=false
MEMORY_INDEX_WORKER_ENABLED=false

# ==================== 向量化配置 ====================
EMBEDDING_DEVICE=cpu

# ==================== Jira Cloud REST v3（可选）====================
JIRA_ENABLED=false
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=your-atlassian-email@example.com
JIRA_API_TOKEN=

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
