# ============================================
# MeetingMind Docker Compose 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================

# ==================== 应用基础配置 ====================
APP_NAME=MeetingMind
APP_ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# ==================== 数据库配置 ====================
POSTGRES_PASSWORD=password

# ==================== Redis配置 ====================
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
QUEUE_PREFETCH_COUNT=1
QUEUE_MAX_RETRIES=2
QUEUE_RETRY_DELAY_SECONDS=5

# ==================== Neo4j配置 ====================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ==================== CORS配置 ====================
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]

# ==================== LLM配置 ====================
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen3.6-plus

# ==================== 向量化配置 ====================
EMBEDDING_DEVICE=cpu

# ==================== Jira Cloud REST v3（可选）====================
JIRA_MCP_ENABLED=false
JIRA_MCP_URL=https://your-site.atlassian.net
JIRA_MCP_USERNAME=your-atlassian-email@example.com
JIRA_MCP_API_TOKEN=

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
