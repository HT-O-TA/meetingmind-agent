# ============================================
# MeetingMind Docker Compose 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================

# ==================== 应用基础配置 ====================
APP_NAME=MeetingMind
APP_ENV=development
DEBUG=false
# 仅开发默认值；production 必须换成至少 32 字符的随机值。
SECRET_KEY=meetingmind-dev-only-secret-change-before-production

# ==================== 数据库配置 ====================
POSTGRES_PASSWORD=password

# ==================== Redis配置 ====================
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
QUEUE_PREFETCH_COUNT=1
QUEUE_MAX_RETRIES=2
QUEUE_RETRY_DELAY_SECONDS=5

# ==================== 本地 ASR（可选）====================
ENABLE_ASR=false
ASR_DEVICE=auto
ASR_MODEL=paraformer-zh
ASR_VAD_MODEL=fsmn-vad
ASR_PUNC_MODEL=ct-punc
ASR_SPK_MODEL=cam++
# ASR/FunASR 不在默认 Web 镜像中，按阶段4文档使用独立 GPU 环境运行。

# ==================== CORS配置 ====================
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]

# ==================== LLM配置 ====================
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus

# ==================== 向量化配置 ====================
EMBEDDING_DEVICE=cpu

# ==================== Jira Cloud REST v3（可选）====================
JIRA_ENABLED=false
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=your-atlassian-email@example.com
JIRA_API_TOKEN=

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
