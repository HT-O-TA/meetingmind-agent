# ============================================
# MeetingMind - Git Ignore Configuration
# ============================================

# Model files (too large, should be downloaded separately)
backend/model/
!backend/model/.gitkeep

# Uploaded files
backend/uploads/
!backend/uploads/.gitkeep

# Local Agent checkpoint snapshots (development persistence)
backend/data/

# Python wheels (binary packages)
backend/wheels/

# Environment variables
backend/.env
.env

# Evaluation datasets (large files)
backend/evaluate/chunking/data/
backend/evaluate/*/results/
backend/evaluate/*/*.log

# Test results (Locust, pytest, etc.)
backend/results/
test_docs/

# Generated HTML files from Markdown
docs/*.html

# Personal resume files (contains privacy information)
docs/*简历*

# Interview preparation documents (contains personal interview materials)
docs/面试提问.md

# Metrics documents (contains detailed internal metrics)
docs/量化指标.md

# VSCode
.vscode/
.idea/
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
backend/.mypy_cache/
.coverage
backend/.coverage
htmlcov/
backend/htmlcov/

# Virtual environment
venv/
env/
.env/
.conda/
meetingmind/
backend/venv/
backend/env/
backend/.venv-asr/
backend/.venv-ft/

# Fine-tuning runtime artifacts (keep configs/reports, not model weights)
backend/finetuning/artifacts/

# Logs
logs/
backend/logs/
*.log

# Node.js
node_modules/
frontend/node_modules/
package-lock.json
!frontend/package-lock.json
yarn.lock
dist/
frontend/dist/
build/
frontend/build/
test-report/
frontend/test-report/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Docker
docker-compose.override.yml

# SSL certificates
*.pem
*.key
*.crt

# Benchmark files
backend/rag_baseline.json

# Temporary files
*.tmp
*.temp
test_async_document.py

# Jupyter notebooks
.ipynb_checkpoints/

# TensorFlow/PyTorch cache
.cache/
huggingface/
transformers/
backend/.cache/
backend/huggingface/

# LangSmith traces
.langsmith/
backend/.langsmith/

# Pre-commit hooks
.pre-commit-config.yaml
.pre-commit/

# Local development files
local/
backend/local/

# Generated demo/deployment artifacts
artifacts/

# Local real/public meeting datasets (keep provenance notes, never commit raw media)
/data/Eval_Ali/
/data/VCSUM/
