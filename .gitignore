# ============================================
# MeetingMind - Git Ignore Configuration
# ============================================

# Model files (too large, should be downloaded separately)
backend/model/
!backend/model/.gitkeep
/model/
!/model/.gitkeep

# Uploaded files
backend/uploads/
!backend/uploads/.gitkeep

# Local Agent checkpoint snapshots (development persistence)
backend/data/

# Python wheels (binary packages)
backend/wheels/

# Environment variables
backend/.env
.env

# CC-Switch proxy secrets (NEVER commit)
# 覆盖任意目录层级 + 编辑器/合并工具产生的备份形式（.bak/.orig/.save/.swp 等）
.env.local
*.env.local
.env.local.*
*.env.local.*
.env.*.local

# Evaluation datasets (large files)
backend/evaluate/chunking/data/
backend/evaluate/*/results/
backend/evaluate/*/*.log

# Local evaluation smoke reports superseded by the frozen 100-task reports
artifacts/sample_report_check.md
backend/evaluation/reports/sample_report.md
backend/evaluation/reports/meetingmind_deidentified_v1.md

# Test results (Locust, pytest, etc.)
backend/results/
test_docs/

# # Generated HTML files from Markdown
# docs/*.html

# # Personal resume files (contains privacy information)
# docs/*简历*

# # Interview preparation documents (contains personal interview materials)
# docs/面试提问.md

# # Metrics documents (contains detailed internal metrics)
# docs/量化指标.md

docs/

# VSCode
.vscode/
.idea/

# Claude Code: ignore local state, but track shared Agent/MCP config (Q2=B)
.claude/*
!.claude/agents/
!.claude/agents/**
.claude/settings.local.json
# 取反规则会让上面的密钥规则在该子目录失效，这里补回来
.claude/agents/**/.env*
.claude/agents/**/*id_rsa*
.claude/agents/**/*secret*

# 内部实测记录：含中转站主机名与账号归属说明，默认不入库
docs-internal/

