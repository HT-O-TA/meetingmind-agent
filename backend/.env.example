# MeetingMind 本机 Conda 后端环境变量配置示例
# 在 backend 目录启动时复制为 backend/.env；不要用于 Docker Compose。

# ==================== 应用基础配置 ====================
APP_NAME=MeetingMind
APP_ENV=development
MEETINGMIND_DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/meetingmind

# ==================== CORS跨域配置 ====================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
MAX_FILE_COUNT=50
ALLOWED_FILE_EXTENSIONS=["txt", "pdf", "docx", "md", "csv", "xlsx", "xlsm"]

# ==================== 说话人感知语义分块 ====================
# 默认参数只是可运行初值，不代表已获得真实会议效果指标。
CHUNK_SIZE=300
CHUNK_OVERLAP=30
SPEAKER_MIN_CHUNK_SIZE=50
# 语义分块配置（统一使用 SPEAKER_AWARE_HYBRID）
SEMANTIC_CHUNK_MIN_SIZE=50
SEMANTIC_CHUNK_MAX_SIZE=300
SEMANTIC_CHUNK_OVERLAP=30
SEMANTIC_CHUNK_THRESHOLD=0.7

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== Redis缓存配置 ====================
REDIS_URL=redis://localhost:6379/0

# Agent checkpoint：开发可用 file；生产多副本必须改为 postgres
AGENT_CHECKPOINT_ENABLED=true
AGENT_CHECKPOINT_BACKEND=file
AGENT_CHECKPOINT_PATH=./data/agent_checkpoints.pkl
AGENT_CHECKPOINT_POSTGRES_URL=postgresql://postgres:password@localhost:5432/meetingmind
AGENT_CHECKPOINT_MAX_BYTES=2000000
AGENT_CHECKPOINT_RETENTION_SECONDS=86400
AGENT_CHECKPOINT_CLAIM_LEASE_SECONDS=600
CACHE_TTL=300
CACHE_ENABLED=true
LLM_CACHE_TTL=3600

# ==================== 向量化配置 ====================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DEVICE=cpu
TOP_K_DEFAULT=5
SIMILARITY_THRESHOLD=0.7

# ==================== 本地模型配置 ====================
LOCAL_MODELS_ROOT=../model
LOCAL_MODEL_ONLY=true
COMPLEXITY_MODEL_NAME=Qwen3-1.7B

# ==================== LLM配置（OpenAI兼容接口）====================
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 冻结评测使用 qwen3.7-max-2026-06-08；2026-09-08 后统一使用 qwen3.7-flash。
LLM_MODEL=qwen3.7-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
PLAN_LLM_MAX_TOKENS=3000
LLM_TIMEOUT=120
LLM_MAX_CONTEXT_CHARS=5000
# Token 预算使用供应商实际窗口的显式配置；未知模型回退到 32768。
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_MODEL_CONTEXT_WINDOWS={"qwen3.7-flash":32768}
LLM_RUN_TOKEN_BUDGET=65536
LLM_NODE_TOKEN_BUDGET=32768
LLM_MAX_CALLS_PER_RUN=16
LLM_TOKEN_SAFETY_MARGIN_RATIO=0.15
CONTEXT_MAX_ITEM_CHARS=1600
CONTEXT_MAX_ITEMS=8
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_ANCHOR_MAX_CHARS=700
MODEL_TURBO_NAME=qwen3.7-flash
MODEL_PLUS_NAME=qwen3.7-flash
MODEL_MAX_NAME=qwen3.7-flash
QUALITY_GATE_MODEL=qwen3.7-flash

# ==================== 多路召回与重排序配置 ====================
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
RERANK_TOP_N=10
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_LOCAL_PATH=../model/bge-reranker-v2-m3
ENABLE_RERANK=true

# ==================== Agent规划配置 ====================
ROUTE_TASK_CONFIDENCE_THRESHOLD=0.65
ROUTE_COMPLEXITY_CONFIDENCE_THRESHOLD=0.65

# ==================== RabbitMQ 任务可靠性 ====================
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
QUEUE_PREFETCH_COUNT=1
QUEUE_TASK_TIMEOUT=3600
QUEUE_MAX_RETRIES=2
QUEUE_RETRY_DELAY_SECONDS=5
QUEUE_MAX_LENGTH=10000
QUEUE_TASK_RETENTION_SECONDS=86400

# ==================== 长期记忆索引同步（默认关闭） ====================
# PG 是事实主库；打开后由 Worker 发布 outbox，并要求注入 Milvus/Neo4j 投影器。
QUEUE_MEMORY_INDEX=memory_index
MEMORY_OUTBOX_BATCH_SIZE=50
MEMORY_OUTBOX_PUBLISH_INTERVAL_SECONDS=2
# 当前没有注入 Milvus 记忆投影器；开启会使消息进入重试/死信。
MEMORY_INDEX_WORKER_ENABLED=false

# ==================== Jira Cloud REST v3（阶段 2 唯一正式企业工具）====================
# 默认关闭。先用只读 smoke 验证站点、账号和 Token，再开启 Agent 工具注册。
JIRA_ENABLED=false
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=your-atlassian-email@example.com
JIRA_API_TOKEN=
JIRA_HTTP_TIMEOUT_SECONDS=15
JIRA_MAX_RETRIES=2
JIRA_MAX_RETRY_DELAY_SECONDS=10
