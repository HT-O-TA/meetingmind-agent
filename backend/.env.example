# MeetingMind 后端环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 应用基础配置 ====================
APP_NAME=MeetingMind
APP_ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/meetingmind

# ==================== CORS跨域配置 ====================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
MAX_FILE_COUNT=50
ALLOWED_FILE_EXTENSIONS=["txt", "pdf", "docx", "doc", "md", "csv", "xlsx", "xlsm"]

# ==================== 文本处理配置（SPEAKER_AWARE_HYBRID调优实验）====================
# 最佳配置: min=50, max=300, overlap=30, threshold=0.7, MRR=0.517
# 策略: 统一SPEAKER_AWARE_HYBRID，有说话人信息则用说话人感知，无则降级为纯语义分块
CHUNK_SIZE=300
CHUNK_OVERLAP=30
SPEAKER_MIN_CHUNK_SIZE=50
# 语义分块配置（统一使用 SPEAKER_AWARE_HYBRID）
SEMANTIC_CHUNK_MIN_SIZE=50
SEMANTIC_CHUNK_MAX_SIZE=300
SEMANTIC_CHUNK_OVERLAP=30
SEMANTIC_CHUNK_THRESHOLD=0.7

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== Redis缓存配置 ====================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
CACHE_ENABLED=true
LLM_CACHE_TTL=3600
ENABLE_API_CACHE=true
API_CACHE_TTL=60

# ==================== 向量化配置 ====================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DEVICE=cuda
TOP_K_DEFAULT=5
SIMILARITY_THRESHOLD=0.7

# ==================== 本地模型配置 ====================
LOCAL_MODELS_ROOT=./model

# ==================== LLM配置（OpenAI兼容接口）====================
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen3.6-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=120
LLM_MAX_CONTEXT_CHARS=5000

# ==================== RAG评估配置 ====================
EVAL_LLM_MODEL=qwen-turbo
EVAL_LLM_API_KEY=
EVAL_LLM_API_BASE=
EVAL_LLM_MAX_TOKENS=300
EVAL_SKIP_LLM=true
EVAL_TOP_K=5

# ==================== 多路召回与重排序配置 ====================
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
RERANK_TOP_N=10
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_LOCAL_PATH=./model/bge-reranker-v2-m3
ENABLE_MULTI_RETRIEVAL=true
ENABLE_BM25=true
ENABLE_RERANK=true
RETRIEVAL_STRATEGY=A
ENABLE_SPARSE_RETRIEVAL=false

# 未经离线评测的查询扩展默认不进入正式 Agent/RAG 主链路
ENABLE_QUERY_REWRITE=false
ENABLE_HYDE=false
ENABLE_MULTI_QUERY=false
ENABLE_STEP_BACK=false

# ==================== 多模态服务配置 ====================
VISION_API_BASE=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o
VISION_MAX_TOKENS=1000
WHISPER_API_BASE=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
ENABLE_MULTIMODAL=false

# ==================== Agent规划配置 ====================
ENABLE_TEMPLATE_PLANNING=true
ENABLE_PLAN_VALIDATION=true
ENABLE_PLAN_AUTO_FIX=true
TEMPLATE_MATCH_THRESHOLD=0.2
MAX_TASKS_IN_PLAN=10

# ==================== 知识图谱配置 ====================
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_NEO4J_PERSISTENCE=false
KNOWLEDGE_GRAPH_DEPTH=2
KNOWLEDGE_GRAPH_MIN_SCORE=0.3

# 可选协议与后台消费者均需显式开启
ENABLE_MCP_SERVER=false
ENABLE_AGENT_WORKER=false

# ==================== Docker 部署配置 ====================
# 数据库密码（Docker 环境使用）
POSTGRES_PASSWORD=password

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# 应用运行模式
APP_ENV=development
DEBUG=true

# 生产环境配置（部署时覆盖）
# APP_ENV=production
# DEBUG=false
